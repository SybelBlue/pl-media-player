{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "allow-overlapping-playback": {
      "default": "false",
      "type": "string",
      "format": "boolean"
    },
    "allow-pause": {
      "default": "true",
      "type": "string",
      "format": "boolean"
    },
    "allow-seeking": {
      "default": "true",
      "type": "string",
      "format": "boolean"
    },
    "directory": {
      "default": "clientFilesQuestion",
      "type": "string",
      "enum": [
        "clientFilesQuestion",
        "clientFilesCourse"
      ]
    },
    "extensions": {
      "type": "string"
    },
    "file-name": {
      "type": "string"
    },
    "max-plays": {
      "type": "string",
      "format": "integer"
    },
    "media-type": {
      "default": "auto",
      "type": "string",
      "enum": ["auto", "audio", "video"]
    },
    "player-id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "type": "string"
    },
    "randomize": {
      "default": "false",
      "type": "string",
      "format": "boolean"
    },
    "show-remaining": {
      "default": "true",
      "type": "string",
      "format": "boolean"
    },
    "source-directory": {
      "type": "string"
    },
    "url": {
      "type": "string"
    }
  },
  "required": ["player-id"],
  "oneOf": [
    { "required": ["file-name"] },
    { "required": ["url"] },
    {
      "required": [
        "source-directory",
        "randomize"
      ]
    }
  ],
  "additionalProperties": false
}
