{{! htmlmustache-disable pl-prefer-pl-inputs }}
<div
  class="pl-media-player"
  id="pl-media-player-{{dom_id}}"
  data-pl-media-player-config="{{config_json}}"
>
  {{#youtube}}
    <iframe
      class="pl-media-player-youtube d-block h-auto mx-auto w-100"
      width="560"
      height="315"
      src="{{src}}"
      title="YouTube video player"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
    ></iframe>
  {{/youtube}}
  {{^youtube}}
    <input
      class="pl-media-player-playback-count"
      type="hidden"
      name="{{playback_count_name}}"
      value="{{plays_used}}"
      data-skip-unload-check="true"
    />
    {{#audio}}
      <audio
        controls
        controlslist="nodownload"
        preload="metadata"
        aria-describedby="pl-media-player-status-{{dom_id}}"
      >
        <source src="{{src}}" {{#mime_type}} type="{{mime_type}}"{{/mime_type}} /> Your browser
        cannot play this audio file.
      </audio>
    {{/audio}}
    {{#video}}
      <video
        class="d-block h-auto mx-auto w-100 border rounded-top"
        controls
        controlslist="nodownload"
        preload="metadata"
        aria-describedby="pl-media-player-status-{{dom_id}}"
      >
        <source src="{{src}}" {{#mime_type}} type="{{mime_type}}"{{/mime_type}} /> Your browser
        cannot play this video file.
      </video>
    {{/video}}
    <div
      class="pl-media-player-controls{{#video}} border-top-0 rounded-bottom{{/video}}{{^video}} rounded{{/video}}"
      role="group"
      aria-label="Media controls"
      hidden
    >
      <span
        class="pl-media-player-control-lock pl-media-player-play-lock"
        role="group"
        tabindex="-1"
      >
        <button
          class="pl-media-player-play btn btn-outline-secondary btn-sm"
          type="button"
          aria-label="Play"
          aria-describedby="pl-media-player-status-{{dom_id}}"
          data-icon="play"
        >
          <svg
            class="pl-media-player-icon pl-media-player-icon-play"
            viewBox="0 0 16 16"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M5 3.5 12.5 8 5 12.5Z"></path>
          </svg>
          <svg
            class="pl-media-player-icon pl-media-player-icon-pause"
            viewBox="0 0 16 16"
            aria-hidden="true"
            focusable="false"
          >
            <rect x="4" y="3" width="3" height="10" rx="0.5"></rect>
            <rect x="9" y="3" width="3" height="10" rx="0.5"></rect>
          </svg>
          <svg
            class="pl-media-player-icon pl-media-player-icon-loading"
            viewBox="0 0 16 16"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="8" cy="8" r="5.5"></circle>
          </svg>
        </button>
        <span
          class="pl-media-player-tooltip pl-media-player-play-tooltip bg-dark text-white rounded px-2 py-1 small shadow-sm"
          id="pl-media-player-play-tooltip-{{dom_id}}"
          role="tooltip"
        ></span>
      </span>
      <span
        class="pl-media-player-control-lock pl-media-player-seek-lock"
        role="group"
        tabindex="-1"
      >
        <input
          class="pl-media-player-seek"
          type="range"
          min="0"
          max="0"
          step="0.01"
          value="0"
          aria-label="Seek"
        />
        <span
          class="pl-media-player-tooltip pl-media-player-seek-tooltip bg-dark text-white rounded px-2 py-1 small shadow-sm"
          id="pl-media-player-seek-tooltip-{{dom_id}}"
          role="tooltip"
        ></span>
      </span>
      <span class="pl-media-player-time" aria-live="off">0:00 / 0:00</span>
      <span class="pl-media-player-audio-buttons" role="group" aria-label="Audio controls">
        {{#limited_playback}}
          <span class="pl-media-player-test-sound-control">
            <button
              class="pl-media-player-test-sound btn btn-outline-secondary btn-sm"
              type="button"
              aria-label="Play test sound"
              aria-describedby="pl-media-player-test-sound-tooltip-{{dom_id}}"
            >
              <svg
                class="pl-media-player-icon pl-media-player-icon-test-sound"
                viewBox="0 0 16 16"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M4 5.7a4.3 4.3 0 1 1 8.6 0c0 4-4 4-4 6.6a2.3 2.3 0 0 1-4.6 0"></path>
                <path d="M10.3 5.7a2 2 0 1 0-4 0v.7a1.3 1.3 0 0 0 1.3 1.3H8"></path>
              </svg>
            </button>
            <span
              class="pl-media-player-tooltip pl-media-player-test-sound-tooltip bg-dark text-white rounded px-2 py-1 small shadow-sm"
              id="pl-media-player-test-sound-tooltip-{{dom_id}}"
              role="tooltip"
            >
              Check Audio
            </span>
          </span>
        {{/limited_playback}}
        <span
          class="pl-media-player-control-lock pl-media-player-mute-lock"
          role="group"
          tabindex="-1"
        >
          <button
            class="pl-media-player-mute btn btn-outline-secondary btn-sm"
            type="button"
            aria-label="Mute"
            data-icon="volume"
          >
            <svg
              class="pl-media-player-icon pl-media-player-icon-volume"
              viewBox="0 0 16 16"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M2.5 6h2L8 3v10l-3.5-3h-2Z"></path>
              <path d="M10.5 5.5a3.5 3.5 0 0 1 0 5"></path>
              <path d="M12.5 3.5a6 6 0 0 1 0 9"></path>
            </svg>
            <svg
              class="pl-media-player-icon pl-media-player-icon-muted"
              viewBox="0 0 16 16"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M2.5 6h2L8 3v10l-3.5-3h-2Z"></path>
              <path d="m10.5 6 3.5 4"></path>
              <path d="m14 6-3.5 4"></path>
            </svg>
          </button>
          <span
            class="pl-media-player-tooltip pl-media-player-mute-tooltip bg-dark text-white rounded px-2 py-1 small shadow-sm"
            id="pl-media-player-mute-tooltip-{{dom_id}}"
            role="tooltip"
          ></span>
        </span>
      </span>
      <input
        class="pl-media-player-volume"
        type="range"
        min="0"
        max="1"
        step="0.05"
        value="1"
        aria-label="Volume"
      />
    </div>
    <p class="pl-media-player-message small text-nowrap mb-0" aria-live="polite">
      <span class="pl-media-player-playback-warning text-danger" hidden></span>
      {{#grading_play_count}}
        <span class="pl-media-player-grading-play-count text-muted">{{grading_play_count}}</span>
      {{/grading_play_count}}
      {{#show_remaining}}
        <span class="pl-media-player-remaining text-muted"></span>
      {{/show_remaining}}
      <span class="pl-media-player-status text-danger" id="pl-media-player-status-{{dom_id}}"></span>
    </p>
  {{/youtube}}
</div>
